# Trust the Fluence NetBird mesh root CA system-wide on cloud-vm, so curl,
# git, nix and anything else using the distro bundle accept the mesh's TLS
# hosts without --cacert.
#
# The cert sits sops-encrypted in secrets/cloud-vm.yaml (key mesh_root_ca;
# recipients in .sops.yaml), decrypted by the sops-nix home-manager module
# with this VM's own age key at ~/.config/sops/age/keys.txt (the bootstrap
# makes it and prints its public key). Decrypted secrets live under
# ~/.local/state instead of the upstream default $XDG_RUNTIME_DIR, so they
# survive a reboot and the root unit finds them at boot even before (or
# without) the user's systemd instance.
#
# Getting it into the system store needs root, which standalone home-manager
# lacks, and a system unit cannot be ordered after the user's sops-nix.service.
# So the trigger is the decrypted file itself: mesh-ca.path watches the
# sops-nix directory in ~/.config, where every sops-nix run swaps the
# secrets symlink to a new generation, and starts mesh-ca.service, which copies
# the cert to /usr/local/share/ca-certificates (0644) only when the content
# differs and then runs update-ca-certificates. mesh-ca.service is also wanted
# by multi-user.target, so a boot re-checks it. A missing secret (a new VM
# whose key is not a recipient yet) is logged and skipped, exit 0.
#
# Likewise the sops-nix activation step is wrapped below so a failed decrypt
# warns instead of failing the whole switch; `systemctl --user status
# sops-nix` then shows why. A new VM: add its public key to .sops.yaml, run
# `sops updatekeys secrets/cloud-vm.yaml` (with the admin key), push, pull and
# switch.
#
# Root system units, same pattern as ./lo-accept.nix: activation writes real
# copies to ~/.config/systemd-system, and root links them once:
#
#   sudo systemctl link ~/.config/systemd-system/mesh-ca.{service,path}
#   sudo systemctl enable --now mesh-ca.path mesh-ca.service
#
# Check: `ls /etc/ssl/certs/fluence-mesh-root-ca.pem`; `journalctl -u
# mesh-ca` logs each run. Activation prints the link/daemon-reload reminders.
{
  config,
  inputs,
  lib,
  pkgs,
  ...
}:
let
  secretPath = config.sops.secrets.mesh_root_ca.path;
  # Directory where sops-nix swaps the secrets symlink on every run.
  watchDir = "${config.xdg.configHome}/sops-nix";
  dst = "/usr/local/share/ca-certificates/fluence-mesh-root-ca.crt";
  unitDir = "${config.xdg.configHome}/systemd-system";

  script = pkgs.writeShellScript "mesh-ca" ''
    set -eu
    src=${lib.escapeShellArg secretPath}
    dst=${lib.escapeShellArg dst}
    if ! ${pkgs.gnugrep}/bin/grep -q 'BEGIN CERTIFICATE' "$src" 2>/dev/null; then
      echo "no decrypted cert at $src (not a sops recipient yet?); skipping"
      exit 0
    fi
    if ${pkgs.diffutils}/bin/cmp -s "$src" "$dst" \
      && [ -e /etc/ssl/certs/fluence-mesh-root-ca.pem ]; then
      exit 0
    fi
    mkdir -p "$(dirname "$dst")"
    tmp=$(mktemp "$dst.XXXXXX")
    cat "$src" > "$tmp"
    chmod 644 "$tmp"
    mv -f "$tmp" "$dst"
    echo "installed $dst"
    /usr/sbin/update-ca-certificates
  '';

  units = {
    "mesh-ca.service" = pkgs.writeText "mesh-ca.service" ''
      # Generated by nix-config (hosts/cloud-vm/mesh-ca.nix). Linked into
      # /etc/systemd/system by hand; see hosts/cloud-vm/mesh-ca.nix. Do not
      # edit: the next home-manager switch overwrites it.
      [Unit]
      Description=Install the Fluence mesh root CA into the system trust store

      [Service]
      Type=oneshot
      ExecStart=${script}

      [Install]
      WantedBy=multi-user.target
    '';
    "mesh-ca.path" = pkgs.writeText "mesh-ca.path" ''
      # Generated by nix-config (hosts/cloud-vm/mesh-ca.nix); see there.
      [Unit]
      Description=Watch the decrypted Fluence mesh root CA

      [Path]
      PathChanged=${watchDir}
      Unit=mesh-ca.service

      [Install]
      WantedBy=paths.target
    '';
  };

  writeUnit = name: src: ''
    mc_dst=${lib.escapeShellArg "${unitDir}/${name}"}
    if [ -L "$mc_dst" ]; then
      run rm -f "$mc_dst"
    fi
    if ! cmp -s ${src} "$mc_dst"; then
      if [ -z "''${DRY_RUN:-}" ]; then
        mkdir -p "$(dirname "$mc_dst")"
        mc_tmp=$(mktemp "$mc_dst.XXXXXX")
        cat ${src} > "$mc_tmp"
        chmod 644 "$mc_tmp"
        mv -f "$mc_tmp" "$mc_dst"
      else
        echo "would write $mc_dst" >&2
      fi
    fi
  '';
in
{
  imports = [ inputs.sops-nix.homeManagerModules.sops ];

  sops = {
    defaultSopsFile = (import ../../secrets).cloud-vm;
    defaultSopsFormat = "yaml";
    age.keyFile = "${config.home.homeDirectory}/.config/sops/age/keys.txt";
    defaultSecretsMountPoint = "${config.xdg.stateHome}/sops-nix/secrets.d";
    secrets.mesh_root_ca = { };
  };

  # Upstream's step, but a failed decrypt only warns (see the header), and it
  # runs after reloadSystemd so the first switch already has the unit.
  home.activation.sops-nix = lib.mkForce (
    lib.hm.dag.entryAfter [ "reloadSystemd" ] ''
      if [ -z "''${DRY_RUN:-}" ]; then
        sn_state=$(${config.systemd.user.systemctlPath} --user is-system-running 2>&1 || true)
        if [ "$sn_state" = running ] || [ "$sn_state" = degraded ]; then
          ${config.systemd.user.systemctlPath} --user restart sops-nix \
            || echo "sops-nix: decrypt failed; is this VM's age key a recipient of secrets/cloud-vm.yaml? (see hosts/cloud-vm/mesh-ca.nix)" >&2
        fi
        unset sn_state
      fi
    ''
  );

  home.activation.meshCaUnits = lib.hm.dag.entryAfter [ "linkGeneration" ] (
    lib.concatStrings (lib.mapAttrsToList writeUnit units)
    + ''
      for mc_u in mesh-ca.service mesh-ca.path; do
        if [ "$(/usr/bin/systemctl show "$mc_u" -p NeedDaemonReload --value 2>/dev/null)" = yes ]; then
          echo "mesh-ca: units changed; run: sudo systemctl daemon-reload && sudo systemctl restart mesh-ca.path mesh-ca.service" >&2
          break
        elif [ "$(/usr/bin/systemctl show "$mc_u" -p LoadState --value 2>/dev/null)" != loaded ]; then
          echo "mesh-ca: units not linked yet; see hosts/cloud-vm/mesh-ca.nix (sudo systemctl link ${unitDir}/mesh-ca.{service,path})" >&2
          break
        fi
      done
      unset mc_u
    ''
  );
}
