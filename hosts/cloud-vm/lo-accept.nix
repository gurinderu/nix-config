# Keep `-i lo -j ACCEPT` as the first rule of the iptables filter INPUT chain
# on cloud-vm, ahead of tailscale's ts-input jump.
#
# Why: NetBird's DNS resolver listens on the host's own wt0 address. The
# host's queries to it never touch wt0: they go over `lo`, with that
# 100.64.0.0/10 address as the source. tailscale's ts-input chain (jumped from
# INPUT) has `-s 100.64.0.0/10 ! -i tailscale0 -j DROP`, so those queries are
# dropped and mesh DNS times out (and so does everything that resolves
# through systemd-resolved, sudo's hostname lookup included). netbird's own
# `-i wt0 -j ACCEPT` does not help: the packets arrive on lo. The rule here
# carries no address on purpose, loopback traffic is local by definition.
#
# Both daemons insert at INPUT position 1 on every start, AFTER their unit
# reports started (measured 2026-11-09): tailscaled's ts-input jump about a
# second later (tailscale 1.104.4), netbird's `-i wt0 -j ACCEPT` about six
# seconds later (0.81.4), so a plain oneshot ordered After= them runs too
# early and ends up below. The script therefore re-asserts the rule, then
# polls (up to 30 s) until each active daemon's rule is present and loopback
# has stayed first for a few consecutive checks. A netbird that is running but
# logged out never adds its rule; the script then just times out, still with
# loopback first, and exits 0.
# PartOf= makes a stop/restart of tailscaled or netbird restart this unit too;
# WantedBy= starts it whenever either starts. On a host without netbird
# (cloud-vm-2) the netbird references are inert.
#
# iptables is the system /usr/sbin/iptables (nf_tables backend here), the same
# one tailscale and ufw drive; a nix iptables could pick a different backend.
#
# Root system unit, same pattern as ./netbird.nix: activation writes a real
# copy (systemctl link refuses symlinks) to ~/.config/systemd-system, and root
# links it once:
#
#   sudo systemctl link ~/.config/systemd-system/lo-accept.service
#   sudo systemctl enable --now lo-accept
#
# Check: `sudo iptables -S INPUT` shows `-A INPUT -i lo -j ACCEPT` first;
# `journalctl -u lo-accept` logs each run. A switch that changes the unit
# needs `sudo systemctl daemon-reload && sudo systemctl restart lo-accept`;
# activation prints that reminder. It only nags about linking where
# netbird.service is loaded, since without NetBird nothing needs the rule.
{
  config,
  lib,
  pkgs,
  ...
}:
let
  unitPath = "${config.xdg.configHome}/systemd-system/lo-accept.service";

  script = pkgs.writeShellScript "lo-accept" ''
    ipt="/usr/sbin/iptables -w"
    rule="-i lo -j ACCEPT"

    put_first() {
      while $ipt -C INPUT $rule 2>/dev/null; do
        $ipt -D INPUT $rule
      done
      $ipt -I INPUT 1 $rule
    }
    is_first() {
      [ "$($ipt -S INPUT | ${pkgs.gnused}/bin/sed -n 2p)" = "-A INPUT $rule" ]
    }
    has() {
      $ipt -S INPUT | ${pkgs.gnugrep}/bin/grep -qx -- "-A INPUT $1"
    }
    # Both daemons insert at position 1 some seconds after they report
    # started; wait for each active one's rule to show up.
    peers_ready() {
      if /usr/bin/systemctl -q is-active tailscaled; then
        has "-j ts-input" || return 1
      fi
      if /usr/bin/systemctl -q is-active netbird; then
        has "-i wt0 -j ACCEPT" || return 1
      fi
    }

    put_first
    stable=0
    for _ in $(seq 60); do
      if ! is_first; then
        put_first
        echo "re-inserted loopback accept as INPUT rule 1"
        stable=0
      elif peers_ready; then
        stable=$((stable + 1))
        [ "$stable" -ge 4 ] && exit 0
      fi
      sleep 0.5
    done
    # Timed out, e.g. netbird running but logged out (no wt0 rule ever).
    echo "peer rules not all present after 30 s; current chain:" >&2
    $ipt -S INPUT >&2
    is_first
  '';

  unit = pkgs.writeText "lo-accept.service" ''
    # Generated by nix-config (hosts/cloud-vm/lo-accept.nix). Linked into
    # /etc/systemd/system by hand; see hosts/cloud-vm/lo-accept.nix. Do not
    # edit: the next home-manager switch overwrites it.
    [Unit]
    Description=Keep loopback accept ahead of tailscale's INPUT drop
    After=tailscaled.service netbird.service ufw.service
    PartOf=tailscaled.service netbird.service

    [Service]
    Type=oneshot
    RemainAfterExit=yes
    ExecStart=${script}

    [Install]
    WantedBy=multi-user.target tailscaled.service netbird.service
  '';
in
{
  home.activation.loAcceptUnit = lib.hm.dag.entryAfter [ "linkGeneration" ] ''
    la_dst=${lib.escapeShellArg unitPath}
    if [ -L "$la_dst" ]; then
      run rm -f "$la_dst"
    fi
    if ! cmp -s ${unit} "$la_dst"; then
      if [ -z "''${DRY_RUN:-}" ]; then
        mkdir -p "$(dirname "$la_dst")"
        la_tmp=$(mktemp "$la_dst.XXXXXX")
        cat ${unit} > "$la_tmp"
        chmod 644 "$la_tmp"
        mv -f "$la_tmp" "$la_dst"
      else
        echo "would write $la_dst" >&2
      fi
    fi
    if [ "$(/usr/bin/systemctl show lo-accept -p NeedDaemonReload --value 2>/dev/null)" = yes ]; then
      echo "lo-accept: unit changed; run: sudo systemctl daemon-reload && sudo systemctl restart lo-accept" >&2
    elif [ "$(/usr/bin/systemctl show lo-accept -p LoadState --value 2>/dev/null)" != loaded ] \
      && [ "$(/usr/bin/systemctl show netbird -p LoadState --value 2>/dev/null)" = loaded ]; then
      echo "lo-accept: unit not linked yet; see hosts/cloud-vm/lo-accept.nix (sudo systemctl link $la_dst)" >&2
    fi
  '';
}
