# herdr-notify, VM half: when a herdr-managed Claude Code / Codex agent in the
# default herdr session becomes `done` or `blocked`, a herdr plugin hook spools
# a small fixed-schema record, and the Mac (users/gurinderu/herdr-notify.nix)
# streams those records over ssh with a dedicated key and shows them as Warp
# notifications. Package and wire schema: pkgs/herdr-notify.
#
# What leaves the VM: event kind, agent kind, herdr ids, workspace/tab label,
# the pane's terminal title (<= 40 chars, cleaned), a timestamp and a seq.
# Never agent output, transcripts, diffs, paths, env, tokens or URLs.
#
# 1. The plugin. ~/.local/share/herdr-notify/plugin holds only the manifest,
#    whose hook command is the stable profile path of herdr-notify-hook. The
#    manifest must stay byte-identical across package bumps: herdr copies the
#    event commands into plugins.json when linking, so a changing command
#    would go stale until relinked. herdr resolves the manifest symlink and
#    records the /nix/store path (plugin_root = /nix/store, measured), which
#    is why the hook command is absolute and why activation compares the
#    registered manifest_path with the current one and relinks only when the
#    manifest itself changed (`herdr plugin link` works without a server).
#    herdr 0.9.5 wires the hook of a plugin linked into a running server
#    right away (measured 2026-10-26: the first event was spooled seconds
#    after the link; herdr-warp saw otherwise on 0.8.2). Should an older
#    server not fire it, restart herdr once by hand -- never from here.
#
# 2. The key. sshd reads ~/.ssh/authorized_keys2 by default (AuthorizedKeysFile
#    is unset on this Ubuntu image). Activation writes that file -- a REAL
#    0600 file: a symlink into /nix/store is refused under StrictModes ("bad
#    ownership or modes for directory /nix/store", /nix/store is group-writable).
#    ~/.ssh/authorized_keys (the hand-managed keys) is never touched. A file
#    without our marker line is left alone. No key -> no file (an existing
#    managed file is removed). Revoke: delete the file, or set macPubKey back
#    to null and switch. sshd reads the file per connection; no reload.
#
#    restrict  = no pty, no forwarding of any kind, no ~/.ssh/rc.
#    from=     = the Mac's tailnet addresses only.
#    command=  = herdr-notify-serve; the client's requested command only
#                arrives as SSH_ORIGINAL_COMMAND and is matched against two
#                whole-string patterns (stream / focus), never executed.
#                sshd runs it via the login shell (zsh -c), so .zshenv runs.
{
  config,
  inputs,
  lib,
  pkgs,
  ...
}:
let
  herdr-notify = pkgs.callPackage ../../pkgs/herdr-notify { };
  herdr = inputs.llm-agents.packages.${pkgs.stdenv.hostPlatform.system}.herdr;

  # Public key of ~/.ssh/herdr_notify_ed25519 on the Mac (generated there,
  # see README "herdr-notify"). null = not bootstrapped yet: nothing is
  # authorised and no authorized_keys2 is written.
  macPubKey = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIB1l1x9S93ILZ0pCWl0/sdf2vvNta8sQwFMVpVoLI8gs herdr-notify@macbook";
  # The Mac's tailnet addresses ("Nick's MacBook Air (2)", from `tailscale
  # status --json`; stable per node, change only if it re-registers).
  macFrom = "100.105.59.40/32,fd7a:115c:a1e0::e636:3b28/128";

  checkedKey =
    if macPubKey == null then
      null
    else if builtins.match "ssh-ed25519 [A-Za-z0-9+/]+={0,2}( [A-Za-z0-9@._-]+)?" macPubKey != null then
      macPubKey
    else
      throw "herdr-notify.nix: macPubKey must be a single 'ssh-ed25519 AAAA... comment' line";

  marker = "# managed by nix-config (hosts/cloud-vm/herdr-notify.nix) -- delete this file to revoke the Mac notifier key";
  keyLine =
    if checkedKey == null then
      ""
    else
      ''restrict,from="${macFrom}",command="${herdr-notify}/bin/herdr-notify-serve" ${checkedKey}'';

  pluginDir = "${config.xdg.dataHome}/herdr-notify/plugin";
  hookPath = "${config.home.profileDirectory}/bin/herdr-notify-hook";
in
{
  home.packages = [ herdr-notify ];

  xdg.dataFile."herdr-notify/plugin/herdr-plugin.toml".text = ''
    # Generated by nix-config (hosts/cloud-vm/herdr-notify.nix). Keep this
    # file stable: herdr caches the command below when the plugin is linked.
    id = "herdr-notify"
    name = "herdr-notify"
    version = "1.0.0"
    min_herdr_version = "0.9.0"
    description = "Spool done/needs-input agent events for the Mac notifier"
    platforms = ["linux"]

    [[events]]
    on = "pane.agent_status_changed"
    command = ["${hookPath}"]
  '';

  home.activation.herdrNotifyPlugin = lib.hm.dag.entryAfter [ "linkGeneration" ] ''
    hn_reg=$(${herdr}/bin/herdr plugin list --json 2>/dev/null \
      | ${pkgs.python3}/bin/python3 -I -c '
    import json, sys
    try:
        ps = json.load(sys.stdin)["result"]["plugins"]
    except Exception:
        sys.exit(1)
    for p in ps:
        if p.get("plugin_id") == "herdr-notify":
            print(p.get("manifest_path") or "?")
    ') || hn_reg="?error"
    hn_want=$(readlink -f ${lib.escapeShellArg pluginDir}/herdr-plugin.toml)
    case "$hn_reg" in
      "?error")
        echo "herdr-notify: could not read 'herdr plugin list'; plugin not linked (continuing)" >&2 ;;
      "$hn_want")
        : ;;
      "")
        if run ${herdr}/bin/herdr plugin link ${lib.escapeShellArg pluginDir}; then
          echo "herdr-notify: plugin linked (if no events reach ~/.local/state/herdr-notify, restart herdr once)" >&2
        else
          echo "herdr-notify: 'herdr plugin link' failed (continuing)" >&2
        fi ;;
      *)
        echo "herdr-notify: plugin registered from $hn_reg, relinking to $hn_want" >&2
        run ${herdr}/bin/herdr plugin unlink herdr-notify || true
        run ${herdr}/bin/herdr plugin link ${lib.escapeShellArg pluginDir} \
          || echo "herdr-notify: 'herdr plugin link' failed (continuing)" >&2 ;;
    esac
  '';

  home.activation.herdrNotifyAuthorizedKeys = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
    hn_file="$HOME/.ssh/authorized_keys2"
    hn_marker=${lib.escapeShellArg marker}
    hn_line=${lib.escapeShellArg keyLine}
    hn_ours() { [ -f "$hn_file" ] && [ "$(head -n 1 "$hn_file")" = "$hn_marker" ]; }
    if [ -z "$hn_line" ]; then
      if hn_ours; then
        run rm -f "$hn_file"
        echo "herdr-notify: no Mac key configured, removed $hn_file" >&2
      fi
    elif [ -e "$hn_file" ] && ! hn_ours; then
      echo "herdr-notify: $hn_file exists and is not ours; leaving it alone, Mac key NOT installed" >&2
    elif [ -z "''${DRY_RUN:-}" ]; then
      mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
      hn_tmp=$(mktemp "$HOME/.ssh/.authorized_keys2.XXXXXX")
      printf '%s\n%s\n' "$hn_marker" "$hn_line" > "$hn_tmp"
      chmod 600 "$hn_tmp"
      mv -f "$hn_tmp" "$hn_file"
    else
      echo "would write $hn_file" >&2
    fi
  '';
}
