# herdr-tab-title: herdr tabs that hold a Claude Code / Codex agent are named
# after the agent's terminal title (what it is working on) instead of herdr's
# default "1", "2", .... Manual renames win: a tab is only renamed while it
# carries a numeric default label or the label the hook itself set last
# (recorded in herdr's state dir for the plugin). Logic: ./herdr-tab-title.py.
#
# Same linking scheme as ./herdr-notify.nix (see its header): the manifest
# names the stable profile path of the hook, so it stays byte-identical
# across script changes, and activation relinks only when the registered
# manifest_path differs from the current one.
#
# Events. herdr 0.9.5 does not let plugins hook pane.updated (the event a
# terminal-title change emits; `herdr plugin list` warns "unknown event"),
# and the title is not worth a polling daemon, so the hook catches the title
# at the moments it matters: pane.agent_detected, pane.agent_status_changed
# (Claude Code and Codex retitle while working, so a turn's working -> done
# transition picks up the new topic), pane.focused and tab.focused (the tab
# is fresh by the time you look at it). The startup hook backfills every tab.
# tab.renamed is deliberately not hooked: the hook's own renames would
# re-trigger it. One `herdr api snapshot` per event, a rename only when the
# label changes. Startup hooks do not run on link; to backfill by hand run
# `herdr-tab-title-hook --all`.
{
  config,
  inputs,
  lib,
  pkgs,
  ...
}:
let
  herdr = inputs.llm-agents.packages.${pkgs.stdenv.hostPlatform.system}.herdr;
  hook = pkgs.writeTextFile {
    name = "herdr-tab-title-hook";
    destination = "/bin/herdr-tab-title-hook";
    executable = true;
    text = "#!${pkgs.python3}/bin/python3 -I\n" + builtins.readFile ./herdr-tab-title.py;
  };
  pluginDir = "${config.xdg.dataHome}/herdr-tab-title/plugin";
  hookPath = "${config.home.profileDirectory}/bin/herdr-tab-title-hook";
in
{
  home.packages = [ hook ];

  xdg.dataFile."herdr-tab-title/plugin/herdr-plugin.toml".text = ''
    # Generated by nix-config (hosts/cloud-vm/herdr-tab-title.nix). Keep this
    # file stable: herdr caches the commands below when the plugin is linked.
    id = "herdr-tab-title"
    name = "herdr-tab-title"
    version = "1.0.0"
    min_herdr_version = "0.9.0"
    description = "Name agent tabs after the agent's terminal title"
    platforms = ["linux"]

    [[startup]]
    command = ["${hookPath}"]

    [[events]]
    on = "pane.agent_detected"
    command = ["${hookPath}"]

    [[events]]
    on = "pane.agent_status_changed"
    command = ["${hookPath}"]

    [[events]]
    on = "pane.focused"
    command = ["${hookPath}"]

    [[events]]
    on = "tab.focused"
    command = ["${hookPath}"]
  '';

  home.activation.herdrTabTitlePlugin = lib.hm.dag.entryAfter [ "linkGeneration" ] ''
    htt_reg=$(${herdr}/bin/herdr plugin list --json 2>/dev/null \
      | ${pkgs.python3}/bin/python3 -I -c '
    import json, sys
    try:
        ps = json.load(sys.stdin)["result"]["plugins"]
    except Exception:
        sys.exit(1)
    for p in ps:
        if p.get("plugin_id") == "herdr-tab-title":
            print(p.get("manifest_path") or "?")
    ') || htt_reg="?error"
    htt_want=$(readlink -f ${lib.escapeShellArg pluginDir}/herdr-plugin.toml)
    case "$htt_reg" in
      "?error")
        echo "herdr-tab-title: could not read 'herdr plugin list'; plugin not linked (continuing)" >&2 ;;
      "$htt_want")
        : ;;
      "")
        if run ${herdr}/bin/herdr plugin link ${lib.escapeShellArg pluginDir}; then
          echo "herdr-tab-title: plugin linked; run herdr-tab-title-hook --all to name existing tabs" >&2
        else
          echo "herdr-tab-title: 'herdr plugin link' failed (continuing)" >&2
        fi ;;
      *)
        echo "herdr-tab-title: plugin registered from $htt_reg, relinking to $htt_want" >&2
        run ${herdr}/bin/herdr plugin unlink herdr-tab-title || true
        run ${herdr}/bin/herdr plugin link ${lib.escapeShellArg pluginDir} \
          || echo "herdr-tab-title: 'herdr plugin link' failed (continuing)" >&2 ;;
    esac
  '';
}
